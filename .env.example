# ─── App ────────────────────────────────────────────────────────────────────
# Public base URL of this app (no trailing slash). Used in emails, the install
# snippet and the private test link. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails that become platform admins on first sign-in (you).
ADMIN_EMAILS=you@example.com

# ─── Supabase ───────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "anon" / publishable key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / secret key. SERVER ONLY. Used by the public widget endpoints
# after the bot key + origin are validated. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic ──────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
# Default model for new bots (each bot can override it in Settings).
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5
# Prices in USD per million tokens, per model, as JSON. Check
# https://docs.claude.com/en/docs/about-claude/pricing and update when they change.
# cache_write = 5-minute cache write price; cache_read = cache hit price.
LLM_PRICING_JSON={"claude-haiku-4-5":{"input":1,"output":5,"cache_write":1.25,"cache_read":0.1}}
# Model for the onboarding drafts (FAQ/policy/tone). Haiku is cheapest; Sonnet drafts better.
ONBOARDING_MODEL=claude-haiku-4-5

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# resend.com → API Keys. Free tier: 3,000 emails/month, 100/day.
# Until you verify a domain in Resend, you can only send to your own Resend
# account email, from onboarding@resend.dev.
RESEND_API_KEY=
EMAIL_FROM="Botly <onboarding@resend.dev>"

# ─── WhatsApp Cloud API (optional until Phase 2) ───────────────────────────
# developers.facebook.com → your app → WhatsApp → API Setup.
# Leave empty and every lead records "WhatsApp pending" while email still goes out.
# Use a permanent System User token, not the 24-hour test token.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name and language of an APPROVED utility template with 4 body variables:
# {{1}} bot/business name, {{2}} lead name, {{3}} lead phone, {{4}} need/summary.
WHATSAPP_TEMPLATE_NAME=new_lead
WHATSAPP_TEMPLATE_LANG=en

# ─── Limits (defaults shown) ────────────────────────────────────────────────
KNOWLEDGE_TOKEN_CAP=25000
RATE_LIMIT_VISITOR_PER_10MIN=20
RATE_LIMIT_BOT_PER_MIN=120
DEFAULT_QUOTA_STARTER=2000
DEFAULT_QUOTA_GROWTH=10000
CRAWL_MAX_PAGES=40

# ─── Test-only ──────────────────────────────────────────────────────────────
# Never set in production. Lets end-to-end tests use a scripted model instead
# of calling Anthropic. The app refuses to start the scripted model on Vercel.
# BOTLY_TEST_SCRIPTED_LLM=1

# ─── Scheduled jobs (Vercel Cron, see vercel.json) ─────────────────────────
# Any long random string (e.g. `openssl rand -hex 32`). Vercel sends it with each
# cron call; without it the nightly retention cleanup and Monday reports refuse to run.
CRON_SECRET=

# ─── Retrieval mode (Phase 2, only used when approved knowledge > KNOWLEDGE_TOKEN_CAP) ─
# voyageai.com → API keys. Multilingual embeddings (voyage-3.5-lite). Optional: without it
# retrieval still works using keyword search.
VOYAGE_API_KEY=

# ─── Growth plan: store order lookup (Phase 3) ─────────────────────────────
# 32 random bytes that encrypt each client's Shopify/WooCommerce credentials.
# Generate once: `openssl rand -base64 32`. Never change it after connecting stores
# (existing credentials would stop decrypting). Keep it only on the server.
ENCRYPTION_KEY=
SHOPIFY_API_VERSION=2025-07

# ─── Self-serve SaaS ────────────────────────────────────────────────────────
# Sign-in buttons shown on /login, comma-separated. Enable each one first in
# Supabase → Authentication → Sign In / Providers (Google needs a Google Cloud OAuth client).
# Options: google, azure (Microsoft), github, facebook, linkedin_oidc, apple
NEXT_PUBLIC_AUTH_PROVIDERS=google
# Free trial: days, AI replies, pages read from the website.
TRIAL_DAYS=14
TRIAL_REPLIES=50
TRIAL_CRAWL_PAGES=15
# Monthly prices in rupees shown on the site (must match your Razorpay plans).
PRICE_STARTER_INR=2999
PRICE_GROWTH_INR=9999

# ─── Razorpay (payments) ────────────────────────────────────────────────────
# Dashboard → Account & Settings → API keys (use test keys first).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Subscriptions → Plans: create a monthly plan per tier and paste its plan_ id.
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
# Dashboard → Webhooks: URL https://YOUR_DOMAIN/api/billing/webhook, events subscription.*,
# and the secret you choose there:
RAZORPAY_WEBHOOK_SECRET=

# ─── Your business details (legal pages, footer) ───────────────────────────
BUSINESS_LEGAL_NAME=
BUSINESS_CITY=Chennai
SUPPORT_EMAIL=
GRIEVANCE_OFFICER=
# Optional: a bot key to show a live demo chat on the landing page (add your domain to its allowed domains).
NEXT_PUBLIC_DEMO_BOT_KEY=
# For the super-admin margin estimate.
USD_INR=88
